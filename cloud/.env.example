# Example settings only. Use the hosting provider's private environment settings.
# Do not copy real secrets into this tracked file.
NODE_ENV=production
OPENCANVAS_DB=/var/data/opencanvas.db
ALLOWED_ORIGIN=https://mobming.github.io
ADMIN_USER=owner
ADMIN_PASSWORD=
INVITE_CODE=
BACKUP_DIR=/var/data/backups
BACKUP_KEEP=3

# Optional offsite backups: fill all five, or leave all five empty.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=

# Optional publishing is independent from saving and backups.
BSKY_HANDLE=
BSKY_APP_PASSWORD=
